#, js-format
msgid "Image not found<br>%s"
msgstr "تصویر پیدا نشد<br>%s"

#: admin/assets/dist/js/app.js:2
msgid "No slides found"
msgstr "هیچ اسلایدی پیدا نشد"

#: admin/assets/dist/js/app.js:2
#, js-format
msgid "Loading %s slideshows..."
msgstr "در حال بارگذاری %s اسلایدشو..."

#: admin/assets/dist/js/app.js:2
