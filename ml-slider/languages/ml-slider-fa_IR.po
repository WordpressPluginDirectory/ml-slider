msgstr "نزولی"

#: admin/assets/dist/js/app.js:2
msgid "Order By"
msgstr "ترتیب بر اساس"

#: admin/assets/dist/js/app.js:2
msgid "Items Per Page"
msgstr "موارد در هر صفحه"

#: admin/assets/dist/js/app.js:2
msgid "External Media Quality"
msgstr "کیفیت رسانه‌های خارجی"

#: admin/assets/dist/js/app.js:2
msgid ""
"Choose the default quality for images and videos from Unsplash and Pixabay. "
"Higher quality means larger downloads, which can be slow or fail on some "
"hosts. Sizes are a maximum, not a guarantee - smaller originals won't be "
"scaled up, and not every video size is available for every clip."
msgstr ""
"کیفیت پیش‌فرض برای تصاویر و ویدئوها از Unsplash و Pixabay را انتخاب کنید. "
"کیفیت بالاتر به معنای دانلودهای بزرگتر است که ممکن است در بعضی هاست‌ها کند "
"یا با مشکل مواجه شود. اندازه‌ها حداکثر هستند و تضمینی وجود ندارد - نسخه‌های "
"اصلی کوچکتر بزرگ‌تر نمی‌شوند و هر اندازه ویدئو برای هر کلیپ در دسترس نیست."

#: admin/assets/dist/js/app.js:2
msgid "Unsplash Image Quality"
msgstr "کیفیت تصویر Unsplash"

#: admin/assets/dist/js/app.js:2
msgid "Optimized - up to 2560px (recommended)"
msgstr "بهینه شده - تا ۲۵۶۰px (توصیه شده)"

#: admin/assets/dist/js/app.js:2
msgid "Regular - 1080px"
msgstr "عادی - ۱۰۸۰px"

#: admin/assets/dist/js/app.js:2
msgid "Pixabay Image Quality"
msgstr "کیفیت تصویر Pixabay"

#: admin/assets/dist/js/app.js:2
msgid "Large - up to 1280px (recommended)"
msgstr "بزرگ - تا ۱۲۸۰px (توصیه شده)"

#: admin/assets/dist/js/app.js:2
msgid "Medium - up to 640px"
msgstr "متوسط - تا ۶۴۰px"

#: admin/assets/dist/js/app.js:2
msgid "Pixabay Video Quality"
msgstr "کیفیت ویدئو Pixabay"

#: admin/assets/dist/js/app.js:2
msgid "Full HD - up to 1920px (if available)"
msgstr "Full HD - تا ۱۹۲۰px (در صورت موجود بودن)"

